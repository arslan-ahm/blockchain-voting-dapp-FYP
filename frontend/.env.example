# Frontend Environment Variables

# Blockchain Network Configuration
# Environment: development, staging, or production
VITE_NODE_ENV=development

# Network name: localhost, sepolia, or mainnet
VITE_NETWORK_NAME=localhost

# Chain ID: 31337 (localhost), 11155111 (sepolia), 1 (mainnet)
VITE_CHAIN_ID=31337

# RPC URL for connecting to blockchain network
VITE_RPC_URL=http://127.0.0.1:8545

# Contract Configuration
# Address of the deployed Voting smart contract
VITE_VOTING_CONTRACT_ADDRESS=your_deployed_contract_address_here

# Admin Configuration
# Address of the admin account that can manage campaigns
VITE_ADMIN_WALLET_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Block explorer URL for viewing transactions
VITE_BLOCK_EXPLORER_URL=http://localhost:8545

# Pinata IPFS Configuration
# API key for Pinata IPFS service
VITE_PINATA_API_KEY=your_pinata_api_key_here

# API secret for Pinata IPFS service
VITE_PINATA_API_SECRET=your_pinata_api_secret_here

# JWT token for Pinata (optional, alternative to API key/secret)
VITE_PINATA_JWT_TOKEN=your_pinata_jwt_token_here

# App Configuration
# Display name of the application
VITE_APP_NAME=Blockchain Voting DApp

# Version of the application
VITE_APP_VERSION=1.0.0

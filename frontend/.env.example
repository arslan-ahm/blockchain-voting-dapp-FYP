# Frontend Environment Variables

# Blockchain Network Configuration
VITE_NODE_ENV=your-vite_node_env
VITE_NETWORK_NAME=your-vite_network_name
VITE_CHAIN_ID=your-vite_chain_id
VITE_RPC_URL=your-vite_rpc_url

# Contract Configuration
VITE_CONTRACT_ADDRESS=your-vite_contract_address

# Admin Configuration
VITE_ADMIN_ADDRESS=your-vite_admin_address

# Pinata IPFS Configuration
VITE_PINATA_API_KEY=your-vite_pinata_api_key
VITE_PINATA_API_SECRET=your-vite_pinata_api_secret
VITE_PINATA_JWT=your-vite_pinata_jwt

# App Configuration
VITE_APP_NAME=your-vite_app_name
VITE_APP_VERSION=your-vite_app_version

VITE_INFURA_PROJECT_ID=your-vite_infura_project_id